    93	    payload_two = json.loads(resp_two.data)
    94	    assert payload_one["schema"] == "v1"
    95	    assert payload_one["type"] == "dev.writer.conjunction.success.v1"
    96	    assert payload_one["writer"] == payload_two["writer"]
    97	    assert payload_one["writer"]["writer_route_id"] == "dev.writer.conjunction.v1"
    98	    assert payload_one["writer"]["idempotence_hash"]
