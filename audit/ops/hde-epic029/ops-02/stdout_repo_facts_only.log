    20	def test_dev_sampler_happy_path_and_canonical(monkeypatch):
    21	    app = _app(monkeypatch, "dev")
    22	    payload = {
    23	        "viewer_id": "viewer-123",
    24	        "candidate_ids": ["charlie", "alpha", "bravo"],
    25	        "seed": "s-1",
    26	    }
    27	
    28	    with app.test_client() as client:
    29	        resp = _post(client, payload)
    30	
    31	    assert resp.status_code == 200
    32	    assert resp.data.endswith(b"\n")
    33	
    34	    body = resp.get_data(as_text=True)
    35	    data = json.loads(body)
    36	    assert data == {
    37	        "viewer_id": "viewer-123",
    38	        "meta": {"seed": "s-1"},
    39	        "candidate_ids": ["alpha", "bravo", "charlie"],
    40	    }
    41	
    42	    expected = sercanon(data, sort_keys=True)
    43	    assert resp.data == expected
