    74	        "b_user_id": "right",
    75	        "a_birthdate": "1990-01-01",
    76	        "a_birthtime": "08:30",
    77	        "a_location": "Amsterdam",
    78	        "b_birthdate": "1991-02-02",
    79	        "b_birthtime": "09:45",
    80	        "b_location": "Berlin",
    81	    }
    82	
    83	    resp_one = client.get("/dev/writer/conjunction", query_string=query)
    84	    resp_two = client.get("/dev/writer/conjunction", query_string=query)
    85	
    86	    assert resp_one.status_code == 200
    87	    assert resp_two.status_code == 200
    88	    assert resp_one.headers["Cache-Control"] == "no-store"
