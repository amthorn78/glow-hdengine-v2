    63	def test_dev_sampler_seed_only_changes_seed(monkeypatch):
    64	    app = _app(monkeypatch, "dev")
    65	    base = {
    66	        "viewer_id": "viewer-xyz",
    67	        "candidate_ids": ["delta", "echo", "foxtrot"],
    68	    }
    69	
    70	    with app.test_client() as client:
    71	        with_seed_a = _post(client, {**base, "seed": "111"})
    72	        with_seed_b = _post(client, {**base, "seed": "222"})
    73	
    74	    assert with_seed_a.status_code == 200
    75	    assert with_seed_b.status_code == 200
    76	
    77	    payload_a = json.loads(with_seed_a.data)
    78	    payload_b = json.loads(with_seed_b.data)
    79	
    80	    assert payload_a["candidate_ids"] == payload_b["candidate_ids"]
    81	    assert payload_a["meta"]["seed"] == "111"
    82	    assert payload_b["meta"]["seed"] == "222"
