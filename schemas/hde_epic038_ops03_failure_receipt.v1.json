{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hde_epic038.ops03.failure_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "authorization_sha256", "phase", "code", "launch_consumed", "candidate_admissible", "nonclaims"],
  "properties": {
    "schema": {"const": "hde_epic038.ops03.failure_receipt.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{15,63}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"enum": ["pre_marker", "pre_provider", "capture", "receipt_validation", "final_validation"]},
    "code": {"type": "string", "pattern": "^[a-z0-9_]+$", "minLength": 3, "maxLength": 80},
    "launch_consumed": {"type": "boolean"},
    "candidate_admissible": {"const": false},
    "nonclaims": {"type": "array", "prefixItems": [{"const": "acceptance_token_satisfaction"}, {"const": "deployment"}, {"const": "epic_closeout"}, {"const": "migration"}, {"const": "pf09_status_movement"}, {"const": "production_write_authorization"}, {"const": "qa_pass"}, {"const": "railway_inventory_proof"}, {"const": "retired_transport_availability"}], "items": false}
  }
}
