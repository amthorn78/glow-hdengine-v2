{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hde.release_attestation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_commit",
    "source_commit_exact",
    "source_tree_sha256",
    "release_id",
    "manifest_sha256",
    "validation_result",
    "release_admission",
    "pipeline_stop",
    "rails",
    "files",
    "omitted_files",
    "transcript",
    "nonclaims"
  ],
  "properties": {
    "schema": {"const": "hde.release_attestation.v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_commit_exact": {"type": "boolean"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "release_id": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "validation_result": {"const": "PASS"},
    "release_admission": {"const": "PR06R_B_FINAL_PASS"},
    "pipeline_stop": {"type": "null"},
    "rails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ALLOW_NETWORK", "LANG", "LC_ALL", "PIP_NO_INDEX", "SAFE_MODE", "TZ"],
      "properties": {
        "ALLOW_NETWORK": {"const": "0"},
        "LANG": {"const": "C"},
        "LC_ALL": {"const": "C"},
        "PIP_NO_INDEX": {"const": "1"},
        "SAFE_MODE": {"const": "1"},
        "TZ": {"const": "UTC"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "omitted_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/omitted_file"}
    },
    "transcript": {"$ref": "#/$defs/file"},
    "nonclaims": {
      "type": "array",
      "prefixItems": [
        {"const": "builder_executes_no_ops"},
        {"const": "no_database_write"},
        {"const": "no_deployment_or_migration"},
        {"const": "no_qa_pass_or_acceptance"},
        {"const": "no_pf09_status_movement"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "omitted_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason_codes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    }
  }
}
