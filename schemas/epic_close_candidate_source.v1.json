{
  "$id": "schemas/epic_close_candidate_source.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Closed causal-source contract for the feedback-free epic closeout candidate pair. The paired checker/writer verifies every tracked mode-120000 symlink target against its candidate-HEAD blob in both check and write modes; only the inspected symlink inode's unavoidable kernel-managed atime may advance, and the tool never sets or restores it.",
  "additionalProperties": false,
  "properties": {
    "epic_id": {
      "pattern": "^HDE-EPIC[0-9]{3}$",
      "type": "string"
    },
    "evidence_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding": {
            "$ref": "#/$defs/causal_binding"
          },
          "path": {
            "$ref": "#/$defs/causal_repository_path"
          }
        },
        "required": [
          "binding",
          "path"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "key_outputs": {
      "additionalProperties": false,
      "properties": {
        "close_manifest": {
          "$ref": "#/$defs/repository_path"
        },
        "close_report": {
          "$ref": "#/$defs/repository_path"
        }
      },
      "required": [
        "close_manifest",
        "close_report"
      ],
      "type": "object"
    },
    "nonclaims": {
      "items": {
        "enum": [
          "no_epic_closeout_or_pf09_movement",
          "no_hosted_feedback_or_external_attestation",
          "no_ops_live_qa_deployment_or_release",
          "no_public_contract_runtime_or_data_change",
          "no_qa_acceptance_or_token_satisfaction"
        ]
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "plan_path": {
      "$ref": "#/$defs/causal_repository_path"
    },
    "report_sections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body_lines": {
            "items": {
              "$ref": "#/$defs/causal_report_body_line"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array"
          },
          "heading": {
            "$ref": "#/$defs/causal_report_heading"
          }
        },
        "required": [
          "heading",
          "body_lines"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "epic_close_candidate_source.v1"
    }
  },
  "required": [
    "schema_version",
    "epic_id",
    "plan_path",
    "evidence_inputs",
    "report_sections",
    "key_outputs",
    "nonclaims"
  ],
  "type": "object",
  "$defs": {
    "causal_binding": {
      "allOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        }
      ]
    },
    "causal_repository_path": {
      "allOf": [
        {
          "$ref": "#/$defs/repository_path"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        },
        {
          "not": {
            "pattern": "^[Cc][Aa][Tt][Aa][Ll][Oo][Gg]/[Mm][Aa][Nn][Ii][Ff][Ee][Ss][Tt]\\.[Jj][Ss][Oo][Nn](?:$|[./])"
          }
        }
      ]
    },
    "causal_single_line": {
      "allOf": [
        {
          "$ref": "#/$defs/single_line"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        }
      ]
    },
    "feedback_dependency": {
      "pattern": "(?:^|[^A-Za-z0-9])(?:[Rr][Uu][Nn][^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|(?<![Tt][Ww][Oo][^A-Za-z0-9\\r\\n][Rr][Uu][Nn][^A-Za-z0-9\\r\\n])[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Rr][Ee][Ss][Uu][Ll][Tt][Ss]?|[Oo][Uu][Tt][Cc][Oo][Mm][Ee][Ss]?|[Ss][Tt][Aa][Tt][Uu][Ss](?:[Ee][Ss])?|[Cc][Oo][Nn][Cc][Ll][Uu][Ss][Ii][Oo][Nn][Ss]?|[Aa][Tt][Tt][Ee][Mm][Pp][Tt][Ss]?|[Uu][Rr][Ll][Ss]?)|[Rr][Ee][Cc][Ee][Ii][Pp][Tt][Ss]?|[Aa][Tt][Tt][Ee][Ss][Tt][Aa][Tt][Ii][Oo][Nn][Ss]?|(?:[Hh][Oo][Ss][Tt][Ee][Dd]|[Ww][Oo][Rr][Kk][Ff][Ll][Oo][Ww]|[Cc][Ii]|[Bb][Uu][Ii][Ll][Dd]|[Pp][Ii][Pp][Ee][Ll][Ii][Nn][Ee]|[Jj][Oo][Bb]|[Cc][Oo][Nn][Tt][Ii][Nn][Uu][Oo][Uu][Ss][^A-Za-z0-9\\r\\n]*[Ii][Nn][Tt][Ee][Gg][Rr][Aa][Tt][Ii][Oo][Nn])[^A-Za-z0-9\\r\\n]*(?:(?:[Rr][Uu][Nn]|[Jj][Oo][Bb]|[Ee][Xx][Ee][Cc][Uu][Tt][Ii][Oo][Nn]|[Cc][Hh][Ee][Cc][Kk]|[Aa][Tt][Tt][Ee][Mm][Pp][Tt]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ii][Oo][Nn])[^A-Za-z0-9\\r\\n]*)?(?:[Rr][Ee][Ss][Uu][Ll][Tt][Ss]?|[Oo][Uu][Tt][Cc][Oo][Mm][Ee][Ss]?|[Ss][Tt][Aa][Tt][Uu][Ss](?:[Ee][Ss])?|[Cc][Oo][Nn][Cc][Ll][Uu][Ss][Ii][Oo][Nn][Ss]?|[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Aa][Tt][Tt][Ee][Mm][Pp][Tt][Ss]?|[Uu][Rr][Ll][Ss]?)|[Ll][Aa][Tt][Ee][Rr][^A-Za-z0-9\\r\\n]*[Cc][Oo][Mm][Mm][Ii][Tt][Ss]?|[Ss][Oo][Uu][Rr][Cc][Ee][^A-Za-z0-9\\r\\n]*[Cc][Oo][Mm][Mm][Ii][Tt][Ss]?|[Cc][Oo][Mm][Mm][Ii][Tt][^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Ss][Hh][Aa]|[Hh][Aa][Ss][Hh](?:[Ee][Ss])?)|(?:[Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Ii][Tt]|[Hh][Ee][Aa][Dd]|[Ss][Oo][Uu][Rr][Cc][Ee])[^A-Za-z0-9\\r\\n]*(?:[Cc][Oo][Mm][Mm][Ii][Tt][^A-Za-z0-9\\r\\n]*)?(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Ss][Hh][Aa]|[Hh][Aa][Ss][Hh](?:[Ee][Ss])?)|[Rr][Ee][Ll][Ee][Aa][Ss][Ee][Ss]?[^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?))(?:[^A-Za-z0-9]|$)"
    },
    "repository_path": {
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "causal_report_body_line": {
      "description": "One canonical neutral report statement from the closed writer-owned registry.",
      "allOf": [
        {
          "$ref": "#/$defs/causal_single_line"
        },
        {
          "enum": [
            "Concurrent readers fail closed while publication is unstable.",
            "Candidate publication uses the manifest as its commit point.",
            "Existing candidate outputs are not causal inputs.",
            "Recovery requires a fresh derivation from tracked inputs.",
            "Publication residue is not a candidate input.",
            "The checker does not repair candidate outputs.",
            "Candidate validation compares exact committed bytes.",
            "The report and manifest are accepted only as one committed pair.",
            "Candidate scope is bounded by the declared tracked inputs.",
            "Tracked résumé evidence remains deterministic."
          ]
        },
        {
          "not": {
            "pattern": "(?:^[ \\t]*#{1,2}(?:[ \\t]+|$)|^[ \\t]*(?:`{3,}|~{3,})|^[ \\t]*(?:=+|-+)[ \\t]*$|^[ \\t]*(?:>|[-+*][ \\t]+|[0-9]{1,9}[.)][ \\t]+)|^[ \\t]*\\[[^\\]\\r\\n]+\\]:|[<>])"
          }
        }
      ]
    },
    "causal_report_heading": {
      "description": "One canonical neutral H2 label from the closed writer-owned registry.",
      "allOf": [
        {
          "$ref": "#/$defs/causal_single_line"
        },
        {
          "enum": [
            "Candidate boundaries",
            "Delivered scope",
            "Evidence posture",
            "Validation posture"
          ]
        },
        {
          "pattern": "^(?!.*(?:^|[^A-Za-z0-9])_)(?!.*_(?:[^A-Za-z0-9]|$))[A-Za-z0-9](?:[A-Za-z0-9 _.,:;()/+'-]*[A-Za-z0-9)])?$"
        }
      ]
    },
    "single_line": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uD800-\\uDFFF\\uFEFF\\uFFF9-\\uFFFB]"
      },
      "type": "string"
    }
  }
}
