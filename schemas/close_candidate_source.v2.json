{
  "$id": "schemas/close_candidate_source.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Closed causal-source contract (v2) for the feedback-free close pack of one Epic or CRD. Every causal value is a tracked path, a binding name, a fixed vocabulary value or a single neutral text line; requirement and acceptance text is bound by reference to a tracked requirements document, never copied. The writer adds runtime checks the schema cannot express (bindings resolve, IDs occur in the bound requirements document, decision consistency, prohibited causal inputs).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "close_candidate_source.v2"
    },
    "change_id": {
      "type": "string",
      "pattern": "^HDE-(?:EPIC[0-9]{3}|CRD-[0-9]{4,})$"
    },
    "plan_path": {
      "$ref": "#/$defs/causal_repository_path"
    },
    "evidence_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding": {
            "$ref": "#/$defs/causal_binding"
          },
          "path": {
            "$ref": "#/$defs/causal_repository_path"
          }
        },
        "required": [
          "binding",
          "path"
        ]
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "requirements_binding": {
      "$ref": "#/$defs/causal_binding"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "$ref": "#/$defs/item_id"
          },
          "evidence_bindings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/causal_binding"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "result": {
            "enum": [
              "MET",
              "NOT_MET"
            ]
          },
          "limitation": {
            "$ref": "#/$defs/causal_text"
          }
        },
        "required": [
          "criterion_id",
          "evidence_bindings",
          "limitation",
          "result"
        ]
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "deliverables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/causal_text"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "deferrals": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/item_id"
              },
              "drain_target": {
                "$ref": "#/$defs/causal_text"
              }
            },
            "required": [
              "drain_target",
              "id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/item_id"
              },
              "adr_status": {
                "$ref": "#/$defs/causal_text"
              },
              "rationale": {
                "$ref": "#/$defs/causal_text"
              }
            },
            "required": [
              "adr_status",
              "id",
              "rationale"
            ]
          }
        ]
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "later_drain_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canon_homes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/causal_text"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "locators": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/causal_text"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "current_posture": {
            "$ref": "#/$defs/causal_text"
          },
          "action": {
            "enum": [
              "change to Done",
              "change to Partial",
              "change to Not done",
              "change to Consolidation pending",
              "change to Optional",
              "No status change recommended"
            ]
          },
          "readiness": {
            "enum": [
              "Supportable from repo evidence",
              "Not yet supportable from repo evidence",
              "Already drained into PF-canon"
            ]
          },
          "evidence_bindings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/causal_binding"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "close_expectation": {
            "enum": [
              "at epic close",
              "after an additional PR or OPS slice",
              "after a separate canon-only drain step"
            ]
          }
        },
        "required": [
          "action",
          "canon_homes",
          "close_expectation",
          "current_posture",
          "evidence_bindings",
          "locators",
          "readiness"
        ]
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "tracked_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/ti_id"
          },
          "adr_status": {
            "$ref": "#/$defs/causal_text"
          }
        },
        "required": [
          "adr_status",
          "id"
        ]
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "adr_block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adr_decision"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "closure_override": {
          "$ref": "#/$defs/closure_override"
        }
      },
      "required": [
        "decisions"
      ]
    },
    "closure_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "SATISFIED",
            "NOT SATISFIED"
          ]
        },
        "posture": {
          "enum": [
            "review_trace_only",
            "po_closeout",
            "formal_close_pack_completion"
          ]
        }
      },
      "required": [
        "decision",
        "posture"
      ]
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/causal_text"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "superseded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding": {
            "$ref": "#/$defs/causal_binding"
          },
          "evidence_change": {
            "$ref": "#/$defs/causal_text"
          }
        },
        "required": [
          "binding",
          "evidence_change"
        ]
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "pointers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/causal_pointer"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "qa_rca": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "$ref": "#/$defs/causal_binding"
            }
          },
          "required": [
            "binding"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary_lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/causal_text"
              },
              "minItems": 1,
              "maxItems": 256
            }
          },
          "required": [
            "summary_lines"
          ]
        }
      ]
    },
    "key_outputs": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/causal_output_path"
      },
      "required": [
        "close_manifest",
        "close_report",
        "doc_deltas",
        "drain_targets",
        "qa_step_logs_manifest"
      ]
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "enum": [
          "no_canon_drainage_or_register_movement",
          "no_execution_by_writer",
          "no_hosted_feedback_inputs",
          "no_unbound_claim"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "plan_path",
    "evidence_inputs",
    "requirements_binding",
    "acceptance",
    "deliverables",
    "deferrals",
    "later_drain_statements",
    "tracked_issues",
    "adr_block",
    "closure_decision",
    "follow_ups",
    "superseded",
    "pointers",
    "qa_rca",
    "key_outputs",
    "nonclaims"
  ],
  "$defs": {
    "causal_binding": {
      "allOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        }
      ]
    },
    "causal_repository_path": {
      "allOf": [
        {
          "$ref": "#/$defs/repository_path"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        },
        {
          "not": {
            "pattern": "^[Cc][Aa][Tt][Aa][Ll][Oo][Gg]/[Mm][Aa][Nn][Ii][Ff][Ee][Ss][Tt]\\.[Jj][Ss][Oo][Nn](?:$|[./])"
          }
        }
      ]
    },
    "feedback_dependency": {
      "pattern": "(?:^|[^A-Za-z0-9])(?:[Rr][Uu][Nn][^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|(?<![Tt][Ww][Oo][^A-Za-z0-9\\r\\n][Rr][Uu][Nn][^A-Za-z0-9\\r\\n])[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Rr][Ee][Ss][Uu][Ll][Tt][Ss]?|[Oo][Uu][Tt][Cc][Oo][Mm][Ee][Ss]?|[Ss][Tt][Aa][Tt][Uu][Ss](?:[Ee][Ss])?|[Cc][Oo][Nn][Cc][Ll][Uu][Ss][Ii][Oo][Nn][Ss]?|[Aa][Tt][Tt][Ee][Mm][Pp][Tt][Ss]?|[Uu][Rr][Ll][Ss]?)|[Rr][Ee][Cc][Ee][Ii][Pp][Tt][Ss]?|[Aa][Tt][Tt][Ee][Ss][Tt][Aa][Tt][Ii][Oo][Nn][Ss]?|(?:[Hh][Oo][Ss][Tt][Ee][Dd]|[Ww][Oo][Rr][Kk][Ff][Ll][Oo][Ww]|[Cc][Ii]|[Bb][Uu][Ii][Ll][Dd]|[Pp][Ii][Pp][Ee][Ll][Ii][Nn][Ee]|[Jj][Oo][Bb]|[Cc][Oo][Nn][Tt][Ii][Nn][Uu][Oo][Uu][Ss][^A-Za-z0-9\\r\\n]*[Ii][Nn][Tt][Ee][Gg][Rr][Aa][Tt][Ii][Oo][Nn])[^A-Za-z0-9\\r\\n]*(?:(?:[Rr][Uu][Nn]|[Jj][Oo][Bb]|[Ee][Xx][Ee][Cc][Uu][Tt][Ii][Oo][Nn]|[Cc][Hh][Ee][Cc][Kk]|[Aa][Tt][Tt][Ee][Mm][Pp][Tt]|[Vv][Aa][Ll][Ii][Dd][Aa][Tt][Ii][Oo][Nn])[^A-Za-z0-9\\r\\n]*)?(?:[Rr][Ee][Ss][Uu][Ll][Tt][Ss]?|[Oo][Uu][Tt][Cc][Oo][Mm][Ee][Ss]?|[Ss][Tt][Aa][Tt][Uu][Ss](?:[Ee][Ss])?|[Cc][Oo][Nn][Cc][Ll][Uu][Ss][Ii][Oo][Nn][Ss]?|[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Aa][Tt][Tt][Ee][Mm][Pp][Tt][Ss]?|[Uu][Rr][Ll][Ss]?)|[Ll][Aa][Tt][Ee][Rr][^A-Za-z0-9\\r\\n]*[Cc][Oo][Mm][Mm][Ii][Tt][Ss]?|[Ss][Oo][Uu][Rr][Cc][Ee][^A-Za-z0-9\\r\\n]*[Cc][Oo][Mm][Mm][Ii][Tt][Ss]?|[Cc][Oo][Mm][Mm][Ii][Tt][^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Ss][Hh][Aa]|[Hh][Aa][Ss][Hh](?:[Ee][Ss])?)|(?:[Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Ii][Tt]|[Hh][Ee][Aa][Dd]|[Ss][Oo][Uu][Rr][Cc][Ee])[^A-Za-z0-9\\r\\n]*(?:[Cc][Oo][Mm][Mm][Ii][Tt][^A-Za-z0-9\\r\\n]*)?(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?|[Ss][Hh][Aa]|[Hh][Aa][Ss][Hh](?:[Ee][Ss])?)|[Rr][Ee][Ll][Ee][Aa][Ss][Ee][Ss]?[^A-Za-z0-9\\r\\n]*(?:[Ii][Dd][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Ff][Ii][Ee][Rr][Ss]?|[Ii][Dd][Ee][Nn][Tt][Ii][Tt](?:[Yy]|[Ii][Ee][Ss])|[Nn][Uu][Mm][Bb][Ee][Rr][Ss]?))(?:[^A-Za-z0-9]|$)"
    },
    "repository_path": {
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "single_line": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uD800-\\uDFFF\\uFEFF\\uFFF9-\\uFFFB]"
      },
      "type": "string"
    },
    "causal_text": {
      "allOf": [
        {
          "$ref": "#/$defs/single_line"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        },
        {
          "not": {
            "pattern": "(?:^[ \\t]*#{1,2}(?:[ \\t]+|$)|^[ \\t]*(?:`{3,}|~{3,})|^[ \\t]*(?:=+|-+)[ \\t]*$|^[ \\t]*(?:>|[-+*][ \\t]+|[0-9]{1,9}[.)][ \\t]+)|^[ \\t]*\\[[^\\]\\r\\n]+\\]:|[<>])"
          }
        }
      ]
    },
    "item_id": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
    },
    "ti_id": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^TI-[0-9]{3,}$"
    },
    "causal_pointer": {
      "allOf": [
        {
          "maxLength": 512,
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*/?$"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        }
      ]
    },
    "causal_output_path": {
      "allOf": [
        {
          "$ref": "#/$defs/repository_path"
        },
        {
          "not": {
            "$ref": "#/$defs/feedback_dependency"
          }
        }
      ]
    },
    "pf_title": {
      "allOf": [
        {
          "$ref": "#/$defs/causal_text"
        },
        {
          "maxLength": 96,
          "pattern": "^[A-Z][A-Za-z &'/-]*[A-Za-z]$"
        }
      ]
    },
    "adr_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/causal_text"
        },
        "statement": {
          "$ref": "#/$defs/causal_text"
        },
        "decision_point": {
          "$ref": "#/$defs/causal_text"
        },
        "options_considered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/causal_text"
          },
          "maxItems": 16,
          "uniqueItems": true,
          "anyOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 2
            }
          ]
        },
        "bounding_canon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pf_title"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "final_decision": {
          "$ref": "#/$defs/causal_text"
        },
        "scope": {
          "enum": [
            "canonical",
            "change_specific"
          ]
        },
        "doc_delta_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pf_title"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "bounding_canon",
        "decision_point",
        "doc_delta_targets",
        "final_decision",
        "label",
        "options_considered",
        "scope",
        "statement"
      ]
    },
    "closure_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/causal_text"
        },
        "accepted_gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gap": {
                "$ref": "#/$defs/causal_text"
              },
              "evidence_bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/causal_binding"
                },
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true
              },
              "drain_targets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/pf_title"
                },
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true
              }
            },
            "required": [
              "drain_targets",
              "evidence_bindings",
              "gap"
            ]
          }
        }
      },
      "required": [
        "accepted_gaps",
        "label"
      ]
    }
  }
}
