{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"channels_v1",
"type":"object","additionalProperties":false,
"properties":{
  "channels":{"type":"array","minItems":36,"maxItems":36,
    "items":{"type":"object","additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^\\d{2}-\\d{2}$"},
        "gates":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1,"maximum":64}},
        "centers":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","enum":["head","ajna","throat","g","ego","spleen","solar_plexus","sacral","root"]}},
        "circuit_primary":{"type":"string","enum":["individual","collective","tribal"]},
        "substream":{"type":["string","null"],"enum":["knowing","logic","sensing","integration","centering","defense",null]},
        "primary_domain":{"type":"string","enum":["talk","narrative","bonding_feel","action_voice","rhythm"]},
        "domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["talk","narrative","bonding_feel","action_voice","rhythm"]}},
        "flags":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["format","direct_mt"]}}
      },
      "required":["id","gates","centers","circuit_primary","substream","primary_domain","domains","flags"]
    }
  }
},"required":["channels"]}
