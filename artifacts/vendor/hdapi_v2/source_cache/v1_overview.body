start\",\"authentication\",\"response-format\"]},{\"group\":\"Guides\",\"pages\":[\"guides/plans-and-credits\",\"guides/agentic-tools\",\"guides/error-handling\",\"guides/rate-limiting\",\"guides/coordinates-endpoint\"]},{\"group\":\"Migration\",\"pages\":[\"migration/v1-to-v2\"]}]},{\"tab\":\"API Reference\",\"groups\":[{\"group\":\"v2 Endpoints (Recommended)\",\"openapi\":\"openapi/v2-routes.yaml\",\"pages\":[\"api-reference/v2/overview\",\"api-reference/charts/generate-a-full-chart\",\"api-reference/charts/generate-a-simple-chart\",\"api-reference/charts/generate-a-chart-from-coordinates\"]},{\"group\":\"v1 Endpoints (Legacy)\",\"openapi\":\"openapi/v1-routes.yaml\",\"pages\":[\"api-reference/v1/overview\",\"api-reference/bodygraph/generate-a-complete-bodygraph\",\"api-reference/bodygraph/generate-a-simplified-bodygraph\"]},{\"group\":\"Reference\",\"pages\":[\"api-reference/error-codes\"]}]}]},\"footer\":{\"socials\":{\"website\":\"https://humandesignapi.nl\"},\"links\":[{\"header\":\"Resources\",\"items\":[{\"label\":\"Website\",\"href\":\"https://humandesignapi.nl\"},{\"label\":\"Dashboard\",\"href\":\"https://humandesignapi.nl/dashboard\"}]},{\"header\":\"Legal\",\"items\":[{\"label\":\"Privacy Policy\",\"href\":\"https://humandesignapi.nl/privacy-policy\"},{\"label\":\"Terms of Service\",\"href\":\"https://humandesignapi.nl/tos\"}]}]},\"styling\":{\"latex\":false,\"codeblocks\":\"system\"}},\"docsNavWithMetadata\":{\"global\":null,\"tabs\":[{\"tab\":\"Documentation\",\"groups\":[{\"group\":\"Getting Started\",\"pages\":[{\"title\":\"Human Design API\",\"description\":\"Generate Human Design personality charts from birth date, time, and location.\",\"href\":\"/index\"},{\"title\":\"Quick Start\",\"description\":\"Make your first API call in under 5 minutes.\",\"href\":\"/quickstart\"},{\"title\":\"Authentication\",\"description\":\"How to authenticate with the Human Design API.\",\"href\":\"/authentication\"},{\"title\":\"Response Format\",\"description\":\"The standard response envelope used by all v2 endpoints.\",\"href\":\"/response-format\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Plans \u0026 Credits\",\"description\":\"Understand API plans, credit allocation, and usage tracking.\",\"href\":\"/guides/plans-and-credits\"},{\"title\":\"Using with AI Agents \u0026 LLMs\",\"description\":\"Integrate the Human Design API with AI agents, LLMs, and no-code tools.\",\"href\":\"/guides/agentic-tools\"},{\"title\":\"Error Handling\",\"description\":\"How to handle errors from the Human Design API.\",\"href\":\"/guides/error-handling\"},{\"title\":\"Rate Limiting\",\"description\":\"Understand rate limits and how to handle them.\",\"href\":\"/guides/rate-limiting\"},{\"title\":\"Using Coordinates Instead of Location\",\"description\":\"Generate charts from latitude and longitude without a geocoding key.\",\"href\":\"/guides/coordinates-endpoint\"}]},{\"group\":\"Migration\",\"pages\":[{\"title\":\"Migrating from v1 to v2\",\"description\":\"Step-by-step guide to upgrade from API v1 to v2.\",\"href\":\"/migration/v1-to-v2\"}]}]},{\"tab\":\"API Reference\",\"groups\":[{\"group\":\"v2 Endpoints (Recommended)\",\"pages\":[{\"title\":\"v2 API Overview\",\"description\":\"Overview of the v2 Human Design Chart API.\",\"href\":\"/api-reference/v2/overview\"},{\"title\":\"Generate a full chart\",\"description\":\"Generates a complete Human Design chart from birth date, time, and location.\\nRequires the \\\"advanced\\\" access tier.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/v2-routes.yaml post /charts\",\"href\":\"/api-reference/charts/generate-a-full-chart\",\"autogeneratedByOpenApi\":true},{\"title\":\"Generate a simple chart\",\"description\":\"Generates a simplified Human Design chart with type, profile, gates, channels, and centers.\\nAvailable to any access tier.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/v2-routes.yaml post /charts/simple\",\"href\":\"/api-reference/charts/ge