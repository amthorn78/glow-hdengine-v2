b6-4a5cb02373cd\",\"responses\":{\"200\":\"60b6b51a-a27c-48b1-85e7-617633e0bbd0\",\"400\":\"05b75ee7-e0de-4d56-aa23-fd887639e8c1\",\"401\":\"e70b0996-74f1-41e8-81f0-59ee2cc5dcaf\",\"402\":\"b19d2391-10d7-4ad0-bab0-42d7b1b08ef4\",\"403\":\"dc747200-d089-4db3-ad42-a9bf9c0eec88\",\"429\":\"b65c55aa-8150-4f5a-a3e4-e0f593d8b4a5\",\"500\":\"c83c68e0-fcd5-4abe-81ce-1fee55a60723\"},\"method\":\"post\",\"type\":\"path\",\"servers\":[\"7084a57b-ebc0-49e1-8339-bdcb1bc4b6d2\"],\"path\":\"/charts\",\"baseUrlOptions\":[\"https://api.humandesignapi.nl/v2\"],\"title\":\"Generate a full chart\",\"codeSamples\":[]},\"dependencies\":{\"parameters\":{},\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"birthdate\",\"birthtime\",\"location\"],\"properties\":{\"birthdate\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\",\"description\":\"Date of birth in YYYY-MM-DD format\",\"example\":\"1990-01-15\",\"isRequired\":true,\"uniqueKey\":\"birthdate\",\"typeLabel\":\"string\"},\"birthtime\":{\"type\":\"string\",\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"description\":\"Time of birth in HH:MM format (24-hour)\",\"example\":\"14:30\",\"isRequired\":true,\"uniqueKey\":\"birthtime\",\"typeLabel\":\"string\"},\"location\":{\"type\":\"string\",\"minLength\":4,\"maxLength\":200,\"description\":\"Location of birth (city, country)\",\"example\":\"Amsterdam, The Netherlands\",\"isRequired\":true,\"uniqueKey\":\"location\",\"typeLabel\":\"string\"}},\"uniqueKey\":\"\",\"typeLabel\":\"object\"},\"examples\":{\"Example\":{\"title\":\"Example\",\"value\":{\"birthdate\":\"1990-01-15\",\"birthtime\":\"14:30\",\"location\":\"Amsterdam, The Netherlands\"}}}}},\"exampleType\":\"generated\"},\"responses\":{\"60b6b51a-a27c-48b1-85e7-617633e0bbd0\":{\"description\":\"Chart generated successfully\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"description\":\"Standard API response envelope wrapping all responses\",\"required\":[\"timestamp\",\"success\",\"message\",\"errorCode\",\"type\",\"data\"],\"properties\":{\"timestamp\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO 8601 timestamp of response generation\",\"example\":\"2026-03-24T12:00:00.000Z\",\"isRequired\":true,\"uniqueKey\":\"timestamp\",\"typeLabel\":\"string\u003cdate-time\u003e\"},\"success\":{\"type\":\"boolean\",\"description\":\"Whether the request succeeded\",\"example\":true,\"isRequired\":true,\"uniqueKey\":\"success\",\"typeLabel\":\"boolean\"},\"message\":{\"type\":\"string\",\"description\":\"Human-readable success or error message\",\"example\":\"Chart generated\",\"isRequired\":true,\"uniqueKey\":\"message\",\"typeLabel\":\"string\"},\"errorCode\":{\"type\":\"string\",\"description\":\"Machine-readable error code (empty string on success)\",\"example\":\"\",\"isRequired\":true,\"uniqueKey\":\"errorCode\",\"typeLabel\":\"string\"},\"type\":{\"type\":\"string\",\"description\":\"Data type name of the object in the data field\",\"example\":\"ChartResult\",\"isRequired\":true,\"uniqueKey\":\"type\",\"typeLabel\":\"string\"},\"data\":{\"type\":\"object\",\"description\":\"Full Human Design chart with all properties\",\"properties\":{\"type\":{\"type\":\"string\",\"description\":\"Human Design type: Generator, Manifesting Generator, Projector, Manifestor, or Reflector\",\"example\":\"Generator\",\"uniqueKey\":\"data.type\",\"typeLabel\":\"string\"},\"profile\":{\"type\":\"string\",\"description\":\"Profile line combination\",\"example\":\"6/2\",\"uniqueKey\":\"data.profile\",\"typeLabel\":\"string\"},\"channelsShort\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueKey\":\"data.channelsShort.items.[INDEX]\",\"typeLabel\":\"string\"},\"description\":\"Active channel connections as gate pairs\",\"example\":[\"20-34\",\"10-57\"],\"uniqueKey\":\"data.channelsShort\",\"typeLabel\":\"string[]\"},\"centers\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueKey\":\"data.centers.items.[INDEX]\",\"typeLabel\":\"string\"},\"description\":\"Defined (active) energy centers\",\"example\":[\"G\",\"Sacral\",\"Spleen\",\"Throat\"],\"uniqueKey\":\"data.centers\",\"typeLabel\":\"string[]\"},\"strategy\":{\"type\":\"string\",\"description\":\"Decision-making strategy based on type\",\"example\":\"To Respond\",\"uniqueKey\":\"data.strategy\",\"typeLabel\":\"string\"},\"authority\":{\"type\":\"string\",\"description\":\"Inner authority for decision-making\",\"example\":\"Sacral\",\"uniqueKey\":\"data.authority\",\"typeLabel\":\"string\"},\"incarnationCross\":{\"type\":\"string\",\"description\":\"Incarnation cross with gate numbers\",\"example\":\"Right Angle Cross of Tension (39/38 | 51/57)\",\"uniqueKey\":\"data.incarnationCross\",\"typeLabel\":\"string\"},\"definition\":{\"type\":\"string\",\"description\":\"How defined centers connect: Single, Split, Triple Split, Quad Split, or No Definition\",\"example\":\"Split Definition\",\"uniqueKey\":\"data.definition\",\"typeLabel\":\"string\"},\"signature\":{\"type\":\"string\",\"description\":\"Emotional signature when living correctly\",\"example\":\"Satisfaction\",\"uniqueKey\":\"data.signature\",\"typeLabel\":\"string\"},\"notSelfTheme\":{\"type\":\"string\",\"description\":\"Emotional indicator of misalignment\",\"example\":\"Frustration\",\"uniqueKey\":\"data.notSelfTheme\",\"typeLabel\":\"string\"},\"cognition\":{\"type\":\"string\",\"description\":\"Cognitive processing style\",\"example\":\"Smell\",\"uniqueKey\":\"data.cognition\",\"typeLabel\":\"string\"},\"determination\":{\"type\":\"string\",\"description\":\"Dietary determination for wellbeing\",\"example\":\"Calm Appetite\",\"uniqueKey\":\"data.determination\",\"typeLabel\":\"string\"},\"variables\":{\"type\":\"string\",\"description\":\"Variable configuration (arrow directions)\",\"example\":\"PLL DRL\",\"uniqueKey\":\"data.variables\",\"typeLabel\":\"string\"},\"motivation\":{\"type\":\"string\",\"description\":\"Underlying motivation theme\",\"example\":\"Hope\",\"uniqueKey\":\"data.motivation\",\"typeLabel\":\"string\"},\"transference\":{\"type\":\"string\",\"description\":\"Not-self motivation pattern\",\"example\":\"Guilt\",\"uniqueKey\":\"data.transference\",\"typeLabel\":\"string\"},\"perspective\":{\"type\":\"string\",\"description\":\"Perspective awareness theme\",\"example\":\"Survival\",\"uniqueKey\":\"data.perspective\",\"typeLabel\":\"string\"},\"distraction\":{\"type\":\"string\",\"description\":\"Not-self perspective pattern\",\"example\":\"Power\",\"uniqueKey\":\"data.distraction\",\"typeLabel\":\"string\"},\"environment\":{\"type\":\"string\",\"description\":\"Optimal physical environment\",\"example\":\"Selective Caves\",\"uniqueKey\":\"data.environment\",\"typeLabel\":\"string\"},\"circuitries\":{\"type\":\"string\",\"description\":\"Active circuitry types (comma-separated)\",\"example\":\"Individual, Tribal\",\"uniqueKey\":\"data.circuitries\",\"typeLabel\":\"string\"},\"channelsLong\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueKey\":\"data.channelsLong.items.[INDEX]\",\"typeLabel\":\"string\"},\"description\":\"Full channel names with gate numbers\",\"example\":[\"The Channel of Charisma (20-34)\",\"The Channel of the Brainwave (57-10)\"],\"uniqueKey\":\"data.channelsLong\",\"typeLabel\":\"string[]\"},\"gates\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"uniqueKey\":\"data.gates.items.[INDEX]\",\"typeLabel\":\"string\"},\"description\":\"All activated gate numbers\",\"example\":[\"20\",\"34\",\"10\",\"57\"],\"uniqueKey\":\"data.gates\",\"typeLabel\":\"string[]\"},\"activations\":{\"type\":\"object\",\"description\":\"Planetary gate/line activations for both sides\",\"properties\":{\"design\":{\"type\":\"object\",\"description\":\"Planetary gate.line activations for one side (design or personality)\",\"properties\":{\"sun\":{\"type\":\"string\",\"example\":\"20.1\",\"uniqueKey\":\"data.activations.design.sun\",\"typeLabel\":\"string\"},\"earth\":{\"ty