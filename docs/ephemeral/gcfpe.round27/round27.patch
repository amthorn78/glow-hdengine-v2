+# superseded build.  That is not hypothetical: on 2026-09-21 a withdrawn package was installed
+# in place of its successor, under the identical filename the packager is required to use, and
+# every gate stayed green for a full round.
+#
+# SKILL.md's own declaration line is excluded from the digest, or declaring the value would
+# change it.
+SELF_IDENTITY_RE = re.compile(rb"(?m)^SKILL_TREE_SHA256: [0-9a-f]{64}\n")
+SELF_IDENTITY_DECLARATION_RE = re.compile(r"(?m)^SKILL_TREE_SHA256: ([0-9a-f]{64})$")
