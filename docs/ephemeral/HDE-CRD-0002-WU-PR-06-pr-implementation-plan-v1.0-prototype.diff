+    lines = ["name: ci", "jobs:", "  test:", "    runs-on: ubuntu-latest", "    env:"]
+    lines += [f'      {k}: "{v}"' for k, v in tool.CLOSED_RAILS.items()]
+    lines.append("    steps:")
+    for name, _kind, _reason in tool.REPLAY_INVENTORY:
+        lines.append(f"      - name: {name}")
