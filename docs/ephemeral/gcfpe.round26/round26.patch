+def skill_tree_digest(root: Path) -> str:
+    """Digest of a skill directory: sorted relative paths, each with its content hash."""
+    digest = hashlib.sha256()
+    names = sorted(
+        (item.relative_to(root).as_posix() for item in root.rglob("*") if item.is_file()),
+        key=lambda name: name.encode("utf-8"),
+    )
+    for name in names:
+        data = (root / name).read_bytes()
+        if name == "SKILL.md":
+            data = SELF_IDENTITY_RE.sub(b"", data)
+        digest.update(name.encode("utf-8") + b"\n")
+        digest.update(hashlib.sha256(data).hexdigest().encode("ascii") + b"\n")
+    return digest.hexdigest()
+
