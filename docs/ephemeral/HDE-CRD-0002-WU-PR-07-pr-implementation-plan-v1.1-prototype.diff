+def _crd_close_run_entry(crd_id: str, check_id: str) -> dict[str, object]:
+    root_rel, key_prefix = ADMITTED_CRD_QA[crd_id]
+    qa_harness.validate_check_id(check_id)
+    return {
+        "artifact_key": f"{key_prefix}.close.{check_id}.primary.log",
