+    elif case == "missing_close_run_pointer":
+        source["pointers"].remove("audit/qa/hde-crd-0002/close/")
+    elif case == "wrong_report_output":
+        source["key_outputs"]["close_report"] = "audit/CRD-0002_close_report.md"
