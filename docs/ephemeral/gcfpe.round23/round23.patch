+def _terms_in_proximity(words, terms, span=CURRENT_PF10_WORD_SPAN):
+    """True when every term occurs within `span` words of some occurrence of terms[0]."""
+    positions = {term: [i for i, word in enumerate(words) if word == term] for term in terms}
+    if not all(positions.values()):
+        return False
+    return any(
+        all(any(anchor - span <= i <= anchor + span for i in positions[term]) for term in terms)
