diff --git a/engine/charts/pure.py b/engine/charts/pure.py
new file mode 100644
index 00000000..49ccfb58
--- /dev/null
+++ b/engine/charts/pure.py
@@ -0,0 +1,92 @@
+"""Pure chart validation and normalization (HDE-SEPA006.1).
+
+Data in, data out: no time, randomness, environment, network, provider,
+logging or filesystem access, at import or in any call. The pinned ISO-3166
+and IANA lists arrive as arguments; ``adapter.chart_orchestration`` reads them.
+"""
+from __future__ import annotations
+
+import re
+import unicodedata
+from typing import Any, Container, Dict, NamedTuple, Optional, Tuple
+
+from engine.util.input_validators import parse_time_hh_mm
+
+_MONTH_DAYS = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
+
+
+class ChartInputError(Exception):
+    def __init__(self, code: str, message: str, details: Optional[Dict[str, Any]] = None):
+        super().__init__(message)
+        self.code = code
+        self.message = message
+        self.details = details or {}
+
+
+class BirthInputs(NamedTuple):
+    date: Tuple[int, int, int]
+    time: Tuple[int, int]
+    city: str
+    country: str
+    tz: str
+
+
+def _invalid(field: str, message: str) -> ChartInputError:
+    return ChartInputError("READER_INVALID_INPUT", message, {"field": field})
+
+
+def _parse_date(s: Any) -> Tuple[int, int, int]:
+    # Same acceptance as datetime.strptime(s, "%Y-%m-%d") behind its YYYY-MM-DD
+    # shape check, without strptime's locale and TZ reads.
+    if not isinstance(s, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", s):
+        raise ValueError("date must be YYYY-MM-DD")
+    year, month, day = int(s[0:4]), int(s[5:7]), int(s[8:10])
+    if year < 1 or not 1 <= month <= 12:
+        raise ValueError("date is not a real calendar date")
+    leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+    if not 1 <= day <= _MONTH_DAYS[month - 1] + (1 if month == 2 and leap else 0):
+        raise ValueError("date is not a real calendar date")
+    return year, month, day
+
+
+def validate_birth_inputs(
+    birthdate: Any,
+    birthtime: Any,
+    place: Any,
+    tz: Any,
+    *,
+    iso_codes: Container[str],
+    iana_zones: Container[str],
+) -> BirthInputs:
+    """Validate in the loader's order: date, time, place, tz presence, tz value."""
+    try:
+        date = _parse_date(birthdate)
+    except Exception as e:
+        raise _invalid("date", "invalid date") from e
+    try:
+        hm = parse_time_hh_mm(birthtime)
+    except Exception as e:
+        raise _invalid("time", "invalid time") from e
+    if not isinstance(place, str):
+        raise _invalid("place", "invalid place")
+    parts = [p.strip() for p in unicodedata.normalize("NFC", place).strip().split(",")]
+    if len(parts) != 2 or not parts[0] or not parts[1] or parts[1].upper() not in iso_codes:
+        raise _invalid("place", "invalid place")
+    if tz is None:
+        raise _invalid("tz", "tz required on internal path")
+    if not isinstance(tz, str) or not tz.strip() or tz not in iana_zones:
+        raise _invalid("tz", "invalid tz")
+    return BirthInputs(date, hm, parts[0], parts[1].upper(), tz)
+
+
+def normalize_chart(obj: Dict[str, Any]) -> Dict[str, Any]:
+    """Keep integer gates, convert digit-string gates to int, drop the rest."""
+    out = dict(obj)
+    norm: list[int] = []
+    for g in obj.get("gates", []):
+        if isinstance(g, int):
+            norm.append(g)
+        elif isinstance(g, str) and g.isdigit():
+            norm.append(int(g))
+    out["gates"] = norm
+    return out
diff --git a/tests/adapter/test_chart_orchestration.py b/tests/adapter/test_chart_orchestration.py
new file mode 100644
index 00000000..99f4970b
--- /dev/null
+++ b/tests/adapter/test_chart_orchestration.py
@@ -0,0 +1,160 @@
+from __future__ import annotations
+
+import json
+import logging
+from pathlib import Path
+import re
+
+import pytest
+
+from adapter.chart_orchestration import load_chart
+from adapter.no_io_guard import NoIoGuard
+from engine.charts.pure import ChartInputError
+from engine.serializer.canon import sercanon
+
+ROOT = Path(__file__).resolve().parents[2]
+CID = "CID-0123456789abcdef"
+CID_RE = re.compile(r"^CID-[a-f0-9]{16}$")
+BIRTH = ("1990-01-01", "12:34", "Amsterdam, NL")
+TZ = "Europe/Amsterdam"
+KEYS = ("ts", "route", "provider", "source", "status", "duration_ms", "safe_mode", "correlation_id")
+FIXTURE_CHART = {
+    "gates": [1, 2, 3], "channels_short": [], "centers": [], "type": "", "authority": "",
+    "profile": "", "meta": {"provider": "fixtures", "source": "default"},
+}
+FIXTURE_CHART_BYTES = (
+    b'{"authority":"","centers":[],"channels_short":[],"gates":[1,2,3],'
+    b'"meta":{"provider":"fixtures","source":"default"},"profile":"","type":""}\n'
+)
+
+
+def _call(*args, **kwargs):
+    lines: list[str] = []
+    try:
+        out = load_chart(*args, log_sink=lines.append, **kwargs)
+    except Exception as e:
+        out = e
+    assert len(lines) == 1, lines
+    return out, json.loads(lines[0]), lines[0]
+
+
+def test_positional_and_keyword_forms_return_the_fixture_chart():
+    out, line, _ = _call(*BIRTH, tz=TZ, correlation_id=CID)
+    assert out == FIXTURE_CHART and list(out) == list(FIXTURE_CHART)
+    assert sercanon(out) == FIXTURE_CHART_BYTES
+    assert (line["status"], line["correlation_id"]) == ("ok", CID)
+    # The compat-determinism generator's call form and inputs.
+    for place in ("Austin, US", "New York, US"):
+        out, line, _ = _call(birthdate="1990-05-04", birthtime="14:22", place=place, tz=TZ)
+        assert sercanon(out) == FIXTURE_CHART_BYTES and line["status"] == "ok"
+
+
+def test_each_chart_is_a_fresh_dict():
+    first, _, _ = _call(*BIRTH, tz=TZ)
+    first["gates"].append(99)
+    first["meta"]["provider"] = "changed"
+    assert _call(*BIRTH, tz=TZ)[0] == FIXTURE_CHART
+
+
+@pytest.mark.parametrize(
+    "args,field,message",
+    [
+        (("1990-02-30", "12:34", "Amsterdam, NL"), "date", "invalid date"),
+        (("1990-01-01", "24:00", "Amsterdam, NL"), "time", "invalid time"),
+        (("1990-01-01", "12:34", "Nowhere"), "place", "invalid place"),
+    ],
+)
+def test_each_invalid_field_raises_the_typed_error_and_logs_one_error_line(args, field, message):
+    err, line, _ = _call(*args, tz=TZ)
+    assert isinstance(err, ChartInputError)
+    assert (err.code, err.details, err.message) == ("READER_INVALID_INPUT", {"field": field}, message)
+    assert line["status"] == "error"
+
+
+def test_tz_absent_and_tz_invalid():
+    for kwargs, message in (({}, "tz required on internal path"), ({"tz": "Europe/NotARealCity"}, "invalid tz")):
+        for args, extra in ((BIRTH, {}), ((), dict(zip(("birthdate", "birthtime", "place"), BIRTH)))):
+            err, line, _ = _call(*args, **extra, **kwargs)
+            assert (err.code, err.details, err.message) == ("READER_INVALID_INPUT", {"field": "tz"}, message)
+            assert line["status"] == "error"
+
+
+def test_a_fourth_positional_argument_is_ignored():
+    err, _, _ = _call(*BIRTH, TZ)
+    assert (err.details, err.message) == ({"field": "tz"}, "tz required on internal path")
+
+
+@pytest.mark.parametrize(
+    "args,kwargs",
+    [
+        ((), {}),
+        (("user-abc",), {"correlation_id": "CID-deadbeef"}),
+        ((), {"birthdate": "user-abc", "birthtime": "12:34", "place": "Amsterdam, NL", "tz": TZ}),
+        (("1990-01-01",), {}),
+    ],
+    ids=["no-arguments", "legacy-positional", "legacy-keyword", "date-only"],
+)
+def test_other_argument_shapes_raise_type_error_and_log_one_error_line(args, kwargs):
+    err, line, _ = _call(*args, **kwargs)
+    assert type(err) is TypeError and str(err) == "Invalid arguments to load_chart"
+    assert line["status"] == "error"
+
+
+@pytest.mark.parametrize("value,expected", [("1", True), ("0", False), (None, False)])
+def test_safe_mode_field(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv("SAFE_MODE", raising=False)
+    else:
+        monkeypatch.setenv("SAFE_MODE", value)
+    assert _call(*BIRTH, tz=TZ)[1]["safe_mode"] is expected
+
+
+def test_correlation_id_is_passed_through_or_synthesized():
+    assert _call(*BIRTH, tz=TZ, correlation_id=CID)[1]["correlation_id"] == CID
+    for kwargs in ({}, {"correlation_id": "CID-deadbeef"}):
+        assert CID_RE.match(_call(*BIRTH, tz=TZ, **kwargs)[1]["correlation_id"])
+
+
+def test_log_line_is_keys_only():
+    _, line, raw = _call(*BIRTH, tz=TZ, correlation_id=CID)
+    assert tuple(line) == KEYS
+    assert (line["route"], line["provider"], line["source"]) == ("loader.load_chart", "fixtures", "default")
+    assert type(line["duration_ms"]) is int and type(line["safe_mode"]) is bool
+    for forbidden in ("birthdate", "birthtime", "location", "place", "Amsterdam", "NL", "1990-01-01", "12:34", TZ):
+        assert forbidden not in raw
+
+
+def test_a_raising_sink_does_not_break_the_call():
+    def sink(line):
+        raise RuntimeError("sink down")
+    assert load_chart(*BIRTH, tz=TZ, log_sink=sink) == FIXTURE_CHART
+    with pytest.raises(ChartInputError):
+        load_chart("1990-02-30", "12:34", "Amsterdam, NL", tz=TZ, log_sink=sink)
+
+
+def test_default_sink_is_the_module_logger_and_writes_no_file(monkeypatch, tmp_path, caplog):
+    monkeypatch.chdir(tmp_path)
+    with caplog.at_level(logging.INFO, logger="adapter.chart_orchestration"):
+        assert load_chart(*BIRTH, tz=TZ, correlation_id=CID) == FIXTURE_CHART
+    records = [r for r in caplog.records if r.name == "adapter.chart_orchestration"]
+    assert len(records) == 1 and json.loads(records[0].getMessage())["correlation_id"] == CID
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_validation_does_not_depend_on_the_working_directory(monkeypatch, tmp_path):
+    results = []
+    for cwd in (ROOT, tmp_path):
+        monkeypatch.chdir(cwd)
+        results.append(_call(*BIRTH, tz=TZ)[0])
+        results.append(_call("1990-01-01", "12:34", "Nowhere", tz=TZ)[0].details)
+    assert results[0] == results[2] == FIXTURE_CHART
+    assert results[1] == results[3] == {"field": "place"}
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_no_socket_attempts():
+    with NoIoGuard() as guard:
+        _call(*BIRTH, tz=TZ)
+        _call("1990-02-30", "12:34", "Amsterdam, NL", tz=TZ)
+        _call()
+    assert guard.attempts == 0
diff --git a/tests/adapter/test_chart_orchestration_characterization.py b/tests/adapter/test_chart_orchestration_characterization.py
new file mode 100644
index 00000000..7c76eecd
--- /dev/null
+++ b/tests/adapter/test_chart_orchestration_characterization.py
@@ -0,0 +1,70 @@
+"""The new entry against today's engine/charts/loader.py (HDE-EPIC041 WU-PR-01).
+
+Proves equal results, errors and log fields for every call shape today's
+supported path accepts. WU-PR-02 deletes this file with the loader. Only the
+supported-path shapes are compared: a legacy-signature call would run the
+provider resolver, which writes artifacts/provider/decision.txt.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+import adapter.chart_orchestration as entry
+import engine.charts.loader as loader
+from engine.charts.pure import normalize_chart
+
+ROOT = Path(__file__).resolve().parents[2]
+CID = "CID-0123456789abcdef"
+TZ = "Europe/Amsterdam"
+GENERATOR = [
+    {"birthdate": "1990-05-04", "birthtime": "14:22", "place": "Austin, US", "tz": TZ},
+    {"birthdate": "1992-07-19", "birthtime": "08:05", "place": "New York, US", "tz": TZ},
+]
+SHAPES = [
+    (("1990-01-01", "12:34", "Amsterdam, NL"), {"tz": TZ}),
+    (("1990-01-01", "12:34", "Amsterdam, NL", TZ), {}),
+    (("1990-02-30", "12:34", "Amsterdam, NL"), {"tz": TZ}),
+    (("1990-01-01", "24:00", "Amsterdam, NL"), {"tz": TZ}),
+    (("1990-01-01", "12:34", "Nowhere"), {"tz": TZ}),
+    (("1990-01-01", "12:34", "Amsterdam, NL"), {}),
+    (("1990-01-01", "12:34", "Amsterdam, NL"), {"tz": "Europe/NotARealCity"}),
+    ((), GENERATOR[0]),
+    ((), GENERATOR[1]),
+    ((), {"birthdate": "1990-02-30", "birthtime": "12:34", "place": "Amsterdam, NL", "tz": TZ}),
+    ((), {"birthdate": "1990-01-01", "birthtime": "12:34", "place": "Amsterdam, NL"}),
+    ((), {}),
+    (("1990-01-01",), {}),
+]
+
+
+def _outcome(fn, args, kwargs):
+    try:
+        return ("ok", fn(*args, correlation_id=CID, **kwargs))
+    except TypeError as e:
+        return ("TypeError", str(e))
+    except Exception as e:
+        return ("typed", e.code, e.details.get("field"), e.message)
+
+
+@pytest.mark.parametrize("args,kwargs", SHAPES)
+def test_entry_matches_todays_loader(monkeypatch, tmp_path, args, kwargs):
+    monkeypatch.chdir(ROOT)  # today's validators read the pinned lists relative to the CWD
+    monkeypatch.setattr(loader, "_Path", lambda p: tmp_path / p)
+    lines: list[str] = []
+    assert _outcome(entry.load_chart, args, dict(kwargs, log_sink=lines.append)) == _outcome(loader.load_chart, args, kwargs)
+    # Today's keyword form writes a second line from its recursive call; its last line is the call's own.
+    today = json.loads((tmp_path / "artifacts/logs/loader_call.jsonl").read_text(encoding="utf-8").splitlines()[-1])
+    assert len(lines) == 1
+    new = json.loads(lines[0])
+    for key in ("ts", "duration_ms"):
+        today.pop(key)
+        new.pop(key)
+    assert new == today
+
+
+def test_normalize_chart_matches_todays_normalizer():
+    fixture = entry._fixture_chart()
+    assert normalize_chart(fixture) == loader._normalize_chart(fixture)
