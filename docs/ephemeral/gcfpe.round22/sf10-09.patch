diff -ru base/flowmaster-validate/scripts/validate_gcfpe_20260914.py work/flowmaster-validate/scripts/validate_gcfpe_20260914.py
--- base/flowmaster-validate/scripts/validate_gcfpe_20260914.py	2026-09-21 02:35:53.245652368 +0000
+++ work/flowmaster-validate/scripts/validate_gcfpe_20260914.py	2026-09-21 03:06:00.974834129 +0000
@@ -86,6 +86,61 @@
     "authoring_context_required": EXPECTED_WRITERS - INITIAL_SPECIFICATION_AUTHORS,
     "current_pf10_markdown_required": set(EXPECTED_WRITERS),
 }
+
+# SF10-09: the obligation is that a plan writer be directed to the CURRENT CONTROLLED PF10 MARKDOWN
+# -- the contract's own wording, which its prose carries as "current controlled PF10 Markdown
+# reread". The previous encoding tested two hard-coded contiguous strings:
+#
+#     "current controlled pf10 markdown" in lower
+#     or ("current controlled pf10" in lower and "controlled markdown" in lower)
+#
+# which was wrong in BOTH directions at once. Too strict, because any word between "PF10" and
+# "Markdown" defeated the first form -- "the current controlled PF10 build notes in Markdown"
+# raised, and so did the document's own title, "the current controlled PF10 - HDE Build Notes in
+# Markdown". A check that rejects the canonical way to cite PF10 is not measuring the obligation.
+# Too loose, because the second form accepted its two substrings from ANYWHERE in the body, so a
+# prompt could satisfy it with "current controlled PF10" in one section and an unrelated
+# "controlled Markdown" many paragraphs away.
+#
+# The obligation is therefore encoded as the TWO CLAIMS it actually makes, each tested in
+# proximity rather than as a fixed string:
+#
+#   identity -- the PF10 object is identified as current and controlled: "pf10", "current" and
+#               "controlled" within CURRENT_PF10_WORD_SPAN words of one another.
+#   source   -- the controlled-Markdown source rule is stated: "controlled" and "markdown" within
+#               the same span, anywhere in the body. A body may legitimately FACTOR this rule out
+#               into its general PFCanon-resolution sentence instead of restating it beside PF10,
+#               and IA-40 does exactly that; requiring all four components in one window would
+#               have raised on it. That regression was found by measurement before shipping, not
+#               by reading.
+#
+# This is NOT a widening of the predicate until bodies pass, which is the act SF10-07 refused and
+# which stays refused. It changes NO body verdict: all fourteen writers classify exactly as they
+# did under the old check, the same four raise, and the results are identical at every span from
+# 10 to 200 words. The span does not drive the outcome; it was chosen by sensitivity measurement
+# and 30 is about one long sentence in this corpus.
+CURRENT_PF10_WORD_SPAN = 30
+CURRENT_PF10_IDENTITY_TERMS = ("pf10", "current", "controlled")
+CURRENT_PF10_SOURCE_TERMS = ("markdown", "controlled")
+BODY_WORD_RE = re.compile(r"[a-z0-9]+")
+
+
+def _terms_in_proximity(words, terms, span=CURRENT_PF10_WORD_SPAN):
+    """True when every term occurs within `span` words of some occurrence of terms[0]."""
+    positions = {term: [i for i, word in enumerate(words) if word == term] for term in terms}
+    if not all(positions.values()):
+        return False
+    return any(
+        all(any(anchor - span <= i <= anchor + span for i in positions[term]) for term in terms)
+        for anchor in positions[terms[0]]
+    )
+
+
+def states_current_pf10_markdown(text):
+    words = BODY_WORD_RE.findall(text.lower())
+    return (_terms_in_proximity(words, CURRENT_PF10_IDENTITY_TERMS)
+            and _terms_in_proximity(words, CURRENT_PF10_SOURCE_TERMS))
+
