+"""The recipe for the shipped 091426.1 direct-handoff contract: regenerate_contract.py `generate`, followed by
+the round-a3 H5 step, which sets the contract-only value route_graph_semantics.pr40_entry to the E2 value
+(regenerate_contract.W4) plus the D23-E once-per-merge sentence, read from the decision record: the two
+`> ` lines of that successor section, which ends at the next `### ` or `## ` heading.
+
+Maintained in glow-graph-contract (MODIFICATION-20260923-closeout-residuals ITEM-13), moved from
+docs/ephemeral/modifications/evidence/repair-a4/contract_recipe.py (SFR-A4-1 A4-O1). It no longer derives the
+repository or the regenerator from its own location: the decision record is an argument, and the regenerator
+is the one beside this file. The two release-bound revisions are required and pass through to `generate`.
+
+usage: PYTHONDONTWRITEBYTECODE=1 python3 contract_recipe.py <graph-md> <template-contract> <oracle-file>
+       <decision-record> <out-contract> --contract-revision <x.y.z> --primary-skill-revision <x.y.z>
+       [--check <shipped-contract> ...]   exit 1 unless every named contract is byte-equal to the recipe's output
+
+With --contract-revision 4.1.0 --primary-skill-revision 1.3.0, the template
+docs/graph/contract-template/gcfpe-20260914.1-091426.1-direct-handoff-contract-4.0.6.json and a build of
+docs/graph/parts at ae2bd159..., the output is 6902924a..., 613326 B: the contract shipped before PART-01.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("regenerate_contract", HERE / "regenerate_contract.py")
+rc = importlib.util.module_from_spec(spec); spec.loader.exec_module(rc)
+
+ap = argparse.ArgumentParser(prog="contract_recipe.py")
+ap.add_argument("graph_md"); ap.add_argument("template"); ap.add_argument("oracle")
+ap.add_argument("decision_record"); ap.add_argument("out")
+ap.add_argument("--contract-revision", required=True)
+ap.add_argument("--primary-skill-revision", required=True)
+ap.add_argument("--check", nargs="+", default=[])
+args = ap.parse_args()
+
+DR = Path(args.decision_record).read_text(encoding="utf-8")
+head = "### Successor, 2026-09-23 — PR-40 is entered once per merge (D23-E)"
+assert DR.count(head) == 1, "decision record: the D23-E once-per-merge successor heading must occur exactly once"
+# The section ends at the next level-2 or level-3 heading, so a later successor entry under D23, or a
+# later decision, never contributes a quoted line (MODIFICATION-20260923-closeout-residuals P-21).
+sec = DR[DR.index(head) + len(head):]
+ends = [i for i in (sec.find("\n### "), sec.find("\n## ")) if i >= 0]
+assert ends, "decision record: no heading follows the D23-E once-per-merge successor section"
+sec = sec[:min(ends)]
+quoted = [line for line in sec.split("\n") if line.startswith("> ")]
+assert len(quoted) == 2, f"decision record: the once-per-merge section holds {len(quoted)} '> ' lines, not exactly 2"
+ONCE = " ".join(line[2:].strip() for line in quoted)
+
+with tempfile.TemporaryDirectory() as d:
+    e2_out = Path(d) / "e2-contract.json"
+    assert rc.generate(args.graph_md, args.template, args.oracle, [str(e2_out)],
+                       args.contract_revision, args.primary_skill_revision) in (0, None)
+    e2 = e2_out.read_bytes()
+print("E2 regenerator output", hashlib.sha256(e2).hexdigest(), len(e2))
+canon = lambda obj: (json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode("utf-8")  # noqa: E731
+c = json.loads(e2)
+assert canon(c) == e2 and c["route_graph_semantics"]["pr40_entry"] == rc.W4
+c["route_graph_semantics"]["pr40_entry"] = rc.W4 + " " + ONCE
+new = canon(c)
+Path(args.out).write_bytes(new)
+print("recipe output", hashlib.sha256(new).hexdigest(), len(new))
+bad = [p for p in args.check if Path(p).read_bytes() != new]
+for p in args.check:
+    print(("EQUAL    " if p not in bad else "DIFFERENT"), p)
+raise SystemExit(1 if bad else 0)
