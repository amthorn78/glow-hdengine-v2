+#!/usr/bin/env python3
+"""The registry deriver: the D13-derived fields of every registry row, checked against the graph parts.
+
+Extracted from the section 7.5 rule of docs/ephemeral/modifications/evidence/e1_registry_apply.py
+(execution spec v2, 7.5; MODIFICATION-20260923-closeout-residuals ITEM-13). For each registry row r and
+its part P = <parts-dir>/prompts/<r.prompt_key>.json:
+
+    derived = sorted({e["to"] for e in P["edges"] if e["to_kind"] == "prompt" and e["to"] != P["id"]})
+    r["required_interfaces"] == derived                              # list equality
+    union of r["outputs"][*]["consumers"] == set(derived)            # union over outputs (IA-40 has two)
+    union of r["outputs"][*]["states"] == set(P["node"]["result_states"])
+
+The registry is read with the governance-audit skill's own load_data, imported from the skill directory
+given, so the two never parse it differently. This script never writes the registry; a registry edit is
+made line-anchored in a pull request.
+
+usage: PYTHONDONTWRITEBYTECODE=1 python3 registry_deriver.py <amthor-workspace-governance-audit-dir>
+       <registry.md> <parts-dir> [--derive]
+exit 0 when no row drifts, 1 when any does, 2 on unusable input.
+"""
+import argparse
+import importlib.util
+import json
+import os
+import sys
+
+sys.dont_write_bytecode = True
+
+
+def load_data_from(audit_root):
+    script = os.path.join(audit_root, "scripts", "audit_workspace_governance.py")
+    if not os.path.isfile(script):
+        sys.exit(f"registry_deriver: no governance-audit script at {script}")
+    spec = importlib.util.spec_from_file_location("audit_workspace_governance", script)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.load_data
+
+
+def load_parts(parts_dir):
+    pdir = os.path.join(parts_dir, "prompts")
+    parts = {}
+    for name in sorted(os.listdir(pdir)):
+        if name.endswith(".json"):
+            part = json.load(open(os.path.join(pdir, name), encoding="utf-8"))
+            parts[part["id"]] = part
+    return parts
+
+
+def derive(part):
+    """The values section 7.5 derives for one row: consumers written sorted, states in ASCII order."""
+    interfaces = sorted({e["to"] for e in part["edges"]
+                         if e.get("to_kind") == "prompt" and e["to"] != part["id"]})
+    return {"required_interfaces": interfaces, "consumers": interfaces,
+            "states": sorted(part["node"]["result_states"])}
+
+
+def drift(registry, parts):
+    """Rows whose derived fields disagree with their part, in registry order."""
+    out, missing = [], []
+    for row in registry["prompts"]:
+        key = row["prompt_key"]
+        if key not in parts:
+            missing.append(key)
+            continue
+        want = derive(parts[key])
+        outputs = row.get("outputs") or []
+        consumers = {c for o in outputs for c in (o.get("consumers") or [])}
+        states = {s for o in outputs for s in (o.get("states") or [])}
+        if (row.get("required_interfaces") != want["required_interfaces"]
+                or consumers != set(want["consumers"]) or states != set(want["states"])):
+            out.append(key)
+    return out, missing
+
+
+def main():
+    ap = argparse.ArgumentParser(prog="registry_deriver.py")
+    ap.add_argument("audit_root", help="the amthor-workspace-governance-audit skill directory")
+    ap.add_argument("registry", help="project-prompt-contract-registry.md")
+    ap.add_argument("parts_dir", help="docs/graph/parts")
+    ap.add_argument("--derive", action="store_true", help="also print the values each drifting row must carry")
+    args = ap.parse_args()
+    registry = load_data_from(args.audit_root)(args.registry)
+    if not isinstance(registry, dict) or not isinstance(registry.get("prompts"), list):
+        print(json.dumps({"error": "registry has no prompts list"}))
+        return 2
+    parts = load_parts(args.parts_dir)
+    rows, missing = drift(registry, parts)
+    report = {"rows": len(registry["prompts"]), "parts": len(parts), "drift": rows, "rows_without_part": missing}
+    if args.derive:
+        report["derived"] = {key: derive(parts[key]) for key in rows}
+    print(json.dumps(report, indent=1, ensure_ascii=False))
+    if missing:
+        return 2
+    return 1 if rows else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
