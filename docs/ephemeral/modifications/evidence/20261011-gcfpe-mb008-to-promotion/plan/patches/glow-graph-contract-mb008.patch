+def release_value_ops(path: str | None, graph: dict) -> list[tuple]:
+    """A release's literals that no graph field carries: a JSON file {"release": R, "version_family": V,
+    "ops": [["set", [path...], value] | ["delete", [path...]]]}. R and V must name the graph's candidate, so a
+    file is never applied to another release's build."""
+    if not path:
+        return []
+    doc = json.loads(open(path, "rb").read())
+    assert (doc.get("release"), doc.get("version_family")) == (graph["candidate"]["release"],
+                                                               graph["candidate"]["version_family"]), \
+        "release-values file names another release"
+    unfilled = re.findall(r'"@[A-Z0-9_]+"', json.dumps(doc["ops"]))
+    assert not unfilled, f"release-values file has unfilled markers: {sorted(set(unfilled))}"
+    ops = []
+    for op in doc["ops"]:
+        assert op[0] in ("set", "delete") and isinstance(op[1], list) and op[1], f"bad release-values op: {op!r}"
+        ops.append((op[0], tuple(op[1])) + ((op[2],) if op[0] == "set" else ()))
+    return ops
+
