+    added = [m for m in (graph.get("proofs") or {}).get("sole_added_node") or []
+             if m not in (template.get("member_registry") or {})]
+    return {p for m in added for p in (("member_registry", m, "staged_parent_id"),
+                                       ("notion_page_manifest", m, "parent_id"))}
