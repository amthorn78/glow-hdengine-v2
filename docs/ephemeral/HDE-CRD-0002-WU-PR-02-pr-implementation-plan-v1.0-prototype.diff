+def _nested_release_ids(value: object) -> list[object]:
+    found: list[object] = []
+    if isinstance(value, dict):
+        for key, item in value.items():
+            if key == "release_id":
+                found.append(item)
+            found.extend(_nested_release_ids(item))
+    elif isinstance(value, list):
+        for item in value:
