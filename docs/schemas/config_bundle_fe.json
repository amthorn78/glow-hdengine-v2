        "bands": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "categories": {"$ref": "#/definitions/band_categories"},
        "version": {"const": "2"}
      }
    },
    "channels": {
