            "type": "object",
            "required": ["bounds", "inputs"],
            "additionalProperties": false,
            "properties": {
              "bounds": {
                "type": "object",
                "required": ["min", "max"],
                "additionalProperties": false,
                "properties": {
                  "min": {"type": "integer"},
                  "max": {"type": "integer"}
                }
              },
              "inputs": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bands", "categories", "version"],
