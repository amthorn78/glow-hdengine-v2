{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "magic10", "bands", "channels", "centers", "domains", "alias_policy", "sources"],
  "properties": {
    "schema": {"const": "config_bundle.be.v1"},
    "magic10": {
      "type": "object",
      "required": ["order", "caps", "seeds"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 10,
          "maxItems": 10
        },
        "schema": {"const": "magic10_config.v1"},
        "caps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["bounds", "inputs"],
            "additionalProperties": false,
            "properties": {
              "bounds": {
                "type": "object",
                "required": ["min", "max"],
                "additionalProperties": false,
                "properties": {
                  "min": {"type": "integer"},
                  "max": {"type": "integer"}
                }
              },
              "inputs": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "seeds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["template_id", "seed_version", "updated_at_utc", "checksum_sha256"],
            "additionalProperties": false,
            "properties": {
              "template_id": {"type": "string"},
              "seed_version": {"type": "string"},
              "updated_at_utc": {"type": "string"},
              "checksum_sha256": {"type": "string"}
            }
          }
        }
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "bands", "edges", "clamp", "rounding"],
      "properties": {
        "schema": {"type": "string"},
        "source": {"type": "string"},
        "bands": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 4
        },
        "edges": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 4
        },
        "clamp": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 2,
          "maxItems": 2
        },
        "rounding": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gates", "centers", "circuit_primary", "primary_domain", "domains", "flags"],
        "properties": {
          "id": {"type": "string"},
          "gates": {
            "type": "array",
            "items": {"type": "integer"},
            "minItems": 2,
            "maxItems": 2
          },
          "centers": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 2,
            "maxItems": 2
          },
          "circuit_primary": {"type": "string"},
          "substream": {"type": ["string", "null"]},
          "primary_domain": {"type": "string"},
          "domains": {
            "type": "array",
            "items": {"type": "string"}
          },
          "flags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "centers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "domains": {
      "type": "array",
      "items": {"type": "string"}
    },
    "alias_policy": {
      "type": "object",
      "required": ["mode", "aliases"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string"},
        "aliases": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic10_config", "band_edges", "registry_report"],
      "properties": {
        "magic10_config": {"$ref": "#/definitions/digest"},
        "band_edges": {"$ref": "#/definitions/digest"},
        "registry_report": {"$ref": "#/definitions/digest"}
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "size_bytes": {"type": "integer"}
      }
    }
  }
}
